# ParcAuto Manager - Backend
# Copier en .env et remplir les valeurs. Ne jamais commiter le .env.

NODE_ENV=development
PORT=3001

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=parcauto

# Prisma (DATABASE_URL obligatoire pour le client Prisma)
# Format : mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/parcauto"

# JWT - générer des secrets forts en production (ex: openssl rand -hex 64)
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=refresh-change-me
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=30d

# CORS (frontend)
CORS_ORIGIN=http://localhost:3000

# Stockage objet (MinIO / S3) — Phase 0 S3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=parcauto

# Email (Resend ou Brevo) — Phase 0 S3
EMAIL_PROVIDER=resend
EMAIL_FROM="ParcAuto Manager <no-reply@parcauto.app>"
RESEND_API_KEY=
BREVO_API_KEY=
