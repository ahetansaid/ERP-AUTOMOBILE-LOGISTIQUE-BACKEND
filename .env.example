# ParcAuto Manager - Backend
# Copier en .env et remplir les valeurs. Ne jamais commiter le .env.

NODE_ENV=development
PORT=3001

# ---------------------------------------------------------------------------
# Base de données — PostgreSQL (Neon en production)
# ---------------------------------------------------------------------------
# Prisma utilise UNIQUEMENT DATABASE_URL (provider postgresql).
# - Neon : utiliser l'URL "Pooled connection" (host en -pooler) pour le
#   serverless, avec sslmode=require.
#   Ex : postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/dbname?sslmode=require
# - Local : postgresql://postgres:postgres@localhost:5432/parcauto?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# (Optionnel) URL non poolée pour `prisma migrate deploy` (connexion directe).
# Neon fournit aussi une "Direct connection" (host SANS -pooler).
DIRECT_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# En production, l'application REFUSE de démarrer si l'un des deux secrets est
# absent, laissé à sa valeur d'exemple, identique à l'autre, ou plus court que
# 32 caractères. Le secret de rafraîchissement est celui qui régénère des accès
# indéfiniment : il est tenu au même seuil que l'autre, pas à un seuil moindre.
#
# Génération (un secret DIFFÉRENT pour chacun) :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=refresh-change-me
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=30d

# ---------------------------------------------------------------------------
# CORS (frontend)
# ---------------------------------------------------------------------------
# Origines autorisées, séparées par des virgules. « * » est refusé au
# démarrage : combiné aux requêtes authentifiées, il laisserait n'importe quel
# site appeler l'API au nom de l'utilisateur connecté.
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Compte administrateur initial (npm run seed)
# ---------------------------------------------------------------------------
# Obligatoire hors développement, 12 caractères minimum, et jamais l'un des
# mots de passe d'exemple. Un compte ADMIN donne un accès complet à la société.
SEED_ADMIN_EMAIL=admin@parcauto.local
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Stockage fichiers
#   STORAGE_DRIVER=local  -> filesystem (dev uniquement, PAS sur Vercel)
#   STORAGE_DRIVER=s3     -> Cloudflare R2 / AWS S3 / MinIO (production)
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
# STORAGE_ROOT=./storage/uploads   # driver local seulement

# Cloudflare R2 (driver s3) :
#   S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
#   S3_REGION=auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=parcauto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=resend
EMAIL_FROM="ParcAuto Manager <no-reply@parcauto.app>"
RESEND_API_KEY=
BREVO_API_KEY=

# 2FA
TWO_FA_ISSUER=ParcAuto Manager
