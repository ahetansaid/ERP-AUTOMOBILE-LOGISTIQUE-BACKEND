# MySQL (XAMPP : root sans mot de passe par défaut)
# Créer la base "erp_automobile" dans phpMyAdmin, puis exécuter sql/schema.sql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=erp_automobile

# API
PORT=3001
FRONTEND_URL=http://localhost:3000

# JWT (à changer en production)
JWT_ACCESS_SECRET=change-me-in-production-erp-2025
JWT_REFRESH_SECRET=change-me-refresh-in-production-erp-2025
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
